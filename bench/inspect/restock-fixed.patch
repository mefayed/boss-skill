diff --git a/tests/test_restock.py b/tests/test_restock.py
new file mode 100644
index 0000000..6d5a8fd
--- /dev/null
+++ b/tests/test_restock.py
@@ -0,0 +1,36 @@
+import io
+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from shop.cli import main
+
+EXAMPLES = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "examples")
+
+
+class RestockTest(unittest.TestCase):
+    def setUp(self):
+        d = tempfile.TemporaryDirectory()
+        self.addCleanup(d.cleanup)
+        self.data = os.path.join(d.name, "data")
+        shutil.copytree(EXAMPLES, self.data)
+
+    def run_cli(self, *argv):
+        out = io.StringIO()
+        return main(["--data", self.data] + list(argv), out=out), out.getvalue()
+
+    def test_restock_prints_new_level(self):
+        code, out = self.run_cli("restock", "PEN-03", "5")
+        self.assertEqual(code, 0)
+        self.assertIn("PEN-03 now 20", out)
+
+    def test_restock_persists(self):
+        self.run_cli("restock", "PEN-03", "5")
+        with open(os.path.join(self.data, "inventory.json")) as f:
+            self.assertEqual(json.load(f)["on_hand"]["PEN-03"], 20)
+
+    def test_unknown_sku(self):
+        code, _ = self.run_cli("restock", "NOPE-99", "5")
+        self.assertEqual(code, 1)
