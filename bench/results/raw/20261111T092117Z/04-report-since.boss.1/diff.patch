+def iso_date(text):
+    """Parse a strict YYYY-MM-DD argument into a datetime.date."""
+    try:
+        if len(text) != 10:
+            raise ValueError
+        return datetime.datetime.strptime(text, "%Y-%m-%d").date()
+    except ValueError:
+        raise argparse.ArgumentTypeError("not a date (want YYYY-MM-DD): %r" % text) from None
+
+
 def build_parser():
     """Argument parser for the CLI."""
