+def cmd_restock(args, out):
+    """Add a delivery to stock on hand and save the inventory."""
+    catalog = storage.load_catalog(os.path.join(args.data, "catalog.json"))
+    path = os.path.join(args.data, "inventory.json")
+    inventory = storage.load_inventory(path)
+    if args.sku not in catalog:
+        raise UnknownProduct("unknown SKU: %s" % args.sku)
+    if args.qty < 1:
+        raise ShopError("quantity must be at least 1, got %d" % args.qty)
+    inventory.add_stock(args.sku, args.qty)
+    storage.save_inventory(path, inventory)
+    out.write("%s: +%d, now %d on hand\n" % (args.sku, args.qty, inventory.on_hand[args.sku]))
+
