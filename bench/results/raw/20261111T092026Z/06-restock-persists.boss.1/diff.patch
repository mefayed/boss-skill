diff --git a/tests/test_cli.py b/tests/test_cli.py
index f3f9d9e..20fb512 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,7 +1,10 @@
 import io
 import os
+import shutil
+import tempfile
 import unittest
 
+from shop import storage
 from shop.cli import main
 
 EXAMPLES = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "examples")
@@ -33,3 +36,37 @@ class CliTest(unittest.TestCase):
     def test_missing_data_dir(self):
         code = main(["--data", "/nonexistent", "stock"], out=io.StringIO())
         self.assertEqual(code, 1)
+
+
+class RestockTest(unittest.TestCase):
+    def setUp(self):
+        self.data = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, self.data)
+        for name in ("catalog.json", "orders.json", "inventory.json"):
+            shutil.copy(os.path.join(EXAMPLES, name), self.data)
+
+    def restock(self, *argv):
+        out = io.StringIO()
+        code = main(["--data", self.data, "restock"] + list(argv), out=out)
+        return code, out.getvalue()
+
+    def on_hand(self, sku):
+        return storage.load_inventory(os.path.join(self.data, "inventory.json")).on_hand.get(sku, 0)
+
+    def test_restock_adds_and_saves(self):
+        before = self.on_hand("PEN-03")
+        code, out = self.restock("PEN-03", "5")
+        self.assertEqual(code, 0)
+        self.assertEqual(self.on_hand("PEN-03"), before + 5)
+        self.assertIn("PEN-03", out)
+
+    def test_unknown_sku_is_an_error(self):
+        code, _ = self.restock("NOPE-99", "5")
+        self.assertEqual(code, 1)
+
+    def test_quantity_below_one_is_an_error(self):
+        before = self.on_hand("PEN-03")
+        for qty in ("0", "-3"):
+            code, _ = self.restock("PEN-03", qty)
+            self.assertEqual(code, 1)
+        self.assertEqual(self.on_hand("PEN-03"), before)
