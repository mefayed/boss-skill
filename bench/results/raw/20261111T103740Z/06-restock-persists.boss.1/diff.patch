@@ -1,5 +1,9 @@
+import contextlib
 import io
+import json
 import os
+import shutil
+import tempfile
 import unittest
 
 from shop.cli import main
@@ -33,3 +37,57 @@ class CliTest(unittest.TestCase):
     def test_missing_data_dir(self):
         code = main(["--data", "/nonexistent", "stock"], out=io.StringIO())
         self.assertEqual(code, 1)
+
+
+class RestockTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, self.dir)
+        for name in os.listdir(EXAMPLES):
+            shutil.copy(os.path.join(EXAMPLES, name), self.dir)
+        self.path = os.path.join(self.dir, "inventory.json")
+
+    def read(self):
+        with open(self.path, "rb") as f:
+            return f.read()
+
+    def restock(self, *argv):
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stderr(err):
+            code = main(["--data", self.dir, "restock"] + list(argv), out=out)
+        return code, out.getvalue(), err.getvalue()
+
+    def test_restock_adds_stock(self):
+        before = json.loads(self.read())
+        code, out, _ = self.restock("PEN-03", "5")
+        after = json.loads(self.read())
+        self.assertEqual(code, 0)
+        self.assertIn("20", out)
+        self.assertEqual(before["on_hand"]["PEN-03"], 15)
+        self.assertEqual(after["on_hand"]["PEN-03"], 20)
+        self.assertEqual(after["reserved"], before["reserved"])
+        for sku, n in before["on_hand"].items():
+            if sku != "PEN-03":
+                self.assertEqual(after["on_hand"][sku], n)
+
+    def test_unknown_sku(self):
+        before = self.read()
+        code, _, err = self.restock("NOPE", "5")
+        self.assertEqual(code, 1)
+        self.assertTrue(err.startswith("error: "))
+        self.assertEqual(self.read(), before)
+
+    def test_non_positive_qty(self):
+        before = self.read()
+        for qty in ("0", "-2"):
+            code, _, err = self.restock("PEN-03", qty)
+            self.assertEqual(code, 1)
+            self.assertTrue(err.startswith("error: "))
+            self.assertEqual(self.read(), before)
+
+    def test_non_integer_qty(self):
+        before = self.read()
+        with self.assertRaises(SystemExit) as cm:
+            self.restock("PEN-03", "abc")
+        self.assertEqual(cm.exception.code, 2)
+        self.assertEqual(self.read(), before)
