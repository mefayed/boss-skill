+def parse_date(text):
+    """Validate a YYYY-MM-DD date and return it in canonical form."""
+    try:
+        return datetime.datetime.strptime(text, "%Y-%m-%d").date().isoformat()
+    except ValueError:
+        raise ShopError("not a date (want YYYY-MM-DD): %r" % text) from None
+
+
 def cmd_report(args, out):
+    since = parse_date(args.since) if args.since else None
     catalog = storage.load_catalog(os.path.join(args.data, "catalog.json"))
     orders = storage.load_orders(os.path.join(args.data, "orders.json"))
-    summary = report.sales_summary(orders)
+    summary = report.sales_summary(orders, since=since)
     out.write(report.render_csv(summary, catalog) if args.csv else report.render_text(summary, catalog))
 
 
