+    def refund(self, order_id, sku, quantity):
+        """Refund units of a paid line, restocking them; returns the refunded cents."""
+        order = self.get(order_id)
+        if order.status != "paid":
+            raise RefundError("order %s is %s" % (order_id, order.status))
+        if quantity <= 0:
+            raise RefundError("quantity must be positive")
+        item = order.find_item(sku)
+        if item is None:
+            raise RefundError("%s is not on order %s" % (sku, order_id))
+        remaining = item.quantity - item.refunded_quantity
+        if quantity > remaining:
+            raise RefundError("%s: want to refund %d, only %d left" % (sku, quantity, remaining))
+        amount = refund_amount(item, quantity)
+        self.inventory.add_stock(sku, quantity)
+        item.refunded_quantity += quantity
+        item.refunded_cents += amount
+        return amount
+
     def cancel(self, order_id):
         """Cancel an open order."""
         order = self._open(order_id)
diff --git a/shop/pricing.py b/shop/pricing.py
index c06b481..98e0d41 100644
--- a/shop/pricing.py
+++ b/shop/pricing.py
@@ -14,6 +14,17 @@ def line_total(item):
     return subtotal
 
 
+def refund_amount(item, quantity):
+    """Cents to refund for quantity more units of a paid line, given earlier refunds.
+
+    Refunds are cumulative shares of the line total, so a line refunded in several goes
+    adds up to exactly its line total.
+    """
+    total = line_total(item)
+    refunded_after = item.refunded_quantity + quantity
+    return total * refunded_after // item.quantity - item.refunded_cents
+
+
 def order_total(order):
     """Sum of line totals in cents."""
     return sum(line_total(item) for item in order.items)
