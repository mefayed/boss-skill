+def parse_date(text):
+    """Parse 'YYYY-MM-DD' into a date, raising ShopError if malformed."""
+    try:
+        return datetime.datetime.strptime(text, "%Y-%m-%d").date()
+    except ValueError:
+        raise ShopError("not a date (want YYYY-MM-DD): %r" % text) from None
+
+
 def cmd_report(args, out):
+    since = parse_date(args.since) if args.since is not None else None
