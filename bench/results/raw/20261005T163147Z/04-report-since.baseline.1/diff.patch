+    def test_report_since(self):
+        code, out = run("report", "--since", "2026-03-02")
+        self.assertEqual(code, 0)
+        self.assertIn("Orders: 1", out)
+        self.assertIn("Revenue: 97.09", out)
+
+    def test_report_since_csv(self):
+        code, out = run("report", "--csv", "--since", "2026-03-02")
+        self.assertEqual(code, 0)
+        self.assertEqual(out, "sku,name,category,units,revenue\nTEA-02,Loose leaf tea 100g,pantry,12,97.09\n")
+
+    def test_report_since_malformed(self):
+        for bad in ["2026-13-01", "yesterday", "2026/03/02"]:
+            err = io.StringIO()
+            with redirect_stderr(err):
+                code = main(["--data", EXAMPLES, "report", "--since", bad], out=io.StringIO())
+            self.assertEqual(code, 1)
+            self.assertIn("not a date", err.getvalue())
+
     def test_missing_data_dir(self):
         code = main(["--data", "/nonexistent", "stock"], out=io.StringIO())
         self.assertEqual(code, 1)
