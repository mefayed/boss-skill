-def sales_summary(orders):
-    """Totals over paid orders: order count, units, revenue, and per-SKU units/revenue."""
+def sales_summary(orders, since=None):
+    """Totals over paid orders (created on or after the date since, if given): count, units, revenue, per-SKU."""
