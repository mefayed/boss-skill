diff --git a/tests/test_refunds.py b/tests/test_refunds.py
new file mode 100644
index 0000000..bbcf67e
--- /dev/null
+++ b/tests/test_refunds.py
@@ -0,0 +1,77 @@
+import os
+import tempfile
+import unittest
+
+from shop import storage
+from shop.errors import RefundError, ShopError
+from shop.pricing import line_total
+from shop.report import sales_summary
+from tests.helpers import make_service
+
+
+def paid_order(svc, sku="TEA-02", quantity=12):
+    order = svc.create_order("ada", "2026-01-01")
+    svc.add_item(order.id, sku, quantity)
+    svc.checkout(order.id)
+    return order
+
+
+class RefundTest(unittest.TestCase):
+    def test_refund_uses_discounted_price_and_restocks(self):
+        svc = make_service()
+        order = paid_order(svc)
+        on_hand = svc.inventory.on_hand["TEA-02"]
+        self.assertEqual(svc.refund(order.id, "TEA-02", 12), 9709)
+        self.assertEqual(svc.inventory.on_hand["TEA-02"], on_hand + 12)
+
+    def test_partial_refunds_add_up_exactly(self):
+        svc = make_service()
+        order = paid_order(svc, quantity=13)
+        total = line_total(order.items[0])
+        amounts = [svc.refund(order.id, "TEA-02", q) for q in (1, 5, 3, 4)]
+        self.assertEqual(sum(amounts), total)
+
+    def test_cannot_over_refund(self):
+        svc = make_service()
+        order = paid_order(svc)
+        svc.refund(order.id, "TEA-02", 10)
+        with self.assertRaises(RefundError):
+            svc.refund(order.id, "TEA-02", 3)
+        self.assertTrue(issubclass(RefundError, ShopError))
+
+    def test_only_paid_orders(self):
+        svc = make_service()
+        order = svc.create_order("ada", "2026-01-01")
+        svc.add_item(order.id, "TEA-02", 2)
+        with self.assertRaises(RefundError):
+            svc.refund(order.id, "TEA-02", 1)
+
+    def test_refunds_survive_storage_and_limit_still_applies(self):
+        svc = make_service()
+        order = paid_order(svc)
+        first = svc.refund(order.id, "TEA-02", 5)
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "orders.json")
+            storage.save_orders(path, list(svc.orders.values()))
+            loaded = storage.load_orders(path)
+        self.assertEqual(loaded[0].items[0].refunded_quantity, 5)
+        self.assertEqual(loaded[0].items[0].refunded_cents, first)
+        svc2 = make_service()
+        svc2.orders = {o.id: o for o in loaded}
+        rest = svc2.refund(order.id, "TEA-02", 7)
+        self.assertEqual(first + rest, 9709)
+        with self.assertRaises(RefundError):
+            svc2.refund(order.id, "TEA-02", 1)
+
+    def test_report_is_net_of_refunds(self):
+        svc = make_service()
+        order = paid_order(svc)
+        amount = svc.refund(order.id, "TEA-02", 2)
+        summary = sales_summary(svc.orders.values())
+        self.assertEqual(summary["units"], 10)
+        self.assertEqual(summary["revenue_cents"], 9709 - amount)
+        self.assertEqual(summary["by_sku"]["TEA-02"], {"units": 10, "revenue_cents": 9709 - amount})
+
+
+if __name__ == "__main__":
+    unittest.main()
