+    def refund(self, order_id, sku, quantity):
+        """Refund units of a paid line and restock them; returns the refunded cents.
+
+        Each refund pays back the line total pro rata to the units refunded so far,
+        so several partial refunds of a line add up to exactly its total.
+        """
+        order = self.get(order_id)
+        if order.status != "paid":
+            raise RefundError("order %s is %s" % (order_id, order.status))
+        item = order.find_item(sku)
+        if item is None:
+            raise UnknownProduct(sku)
+        if quantity <= 0:
+            raise RefundError("quantity must be positive")
+        if item.refunded_quantity + quantity > item.quantity:
+            raise RefundError("%s: refund %d, only %d left" % (
+                sku, quantity, item.quantity - item.refunded_quantity))
+        refunded = item.refunded_quantity + quantity
+        amount = line_total(item) * refunded // item.quantity - item.refunded_cents
+        item.refunded_quantity = refunded
+        item.refunded_cents += amount
+        self.inventory.add_stock(sku, quantity)
+        return amount
