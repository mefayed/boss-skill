+def iso_date(text):
+    """argparse type: a YYYY-MM-DD date, returned in canonical form."""
+    try:
+        return datetime.datetime.strptime(text, "%Y-%m-%d").date().isoformat()
+    except ValueError:
+        raise argparse.ArgumentTypeError("not a YYYY-MM-DD date: %r" % text) from None
+
