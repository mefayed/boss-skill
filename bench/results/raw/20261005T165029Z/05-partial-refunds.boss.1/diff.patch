+    def refund(self, order_id, sku, quantity):
+        """Refund units of a paid line and restock them; returns the refunded cents.
+
+        Each refund is the cumulative share of the discounted line total minus what was
+        already refunded, so refunding a whole line in any number of goes sums to its total.
+        """
+        order = self.get(order_id)
+        if order.status != "paid":
+            raise RefundError("order %s is %s" % (order_id, order.status))
+        item = order.find_item(sku)
+        if item is None:
+            raise RefundError("order %s has no line for %s" % (order_id, sku))
+        if quantity <= 0:
+            raise RefundError("quantity must be positive")
+        remaining = item.quantity - item.refunded_quantity
+        if quantity > remaining:
+            raise RefundError("%s: refund %d, only %d left to refund" % (sku, quantity, remaining))
+        refunded_qty = item.refunded_quantity + quantity
+        refunded_cents = line_total(item) * refunded_qty // item.quantity
+        amount = refunded_cents - item.refunded_cents
+        self.inventory.add_stock(sku, quantity)
+        item.refunded_quantity = refunded_qty
+        item.refunded_cents = refunded_cents
+        return amount
